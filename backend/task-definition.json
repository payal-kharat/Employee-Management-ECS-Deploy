
{
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "python:3.10-alpine",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp",
          "name": "backend"
        }
      ],
      "essential": true,
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [],
      "systemControls": []
    }
  ],
  "family": "employee-managemet-${ENV}-backend",
  "executionRoleArn": "arn:aws:iam::552940445807:role/employee-managemet-ecs-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"

"environment": [
  {
    "name": "DB_HOST",
    "value": "mysql"
  },
  {
    "name": "DB_PORT",
    "value": "3306"
  },
  {
    "name": "DB_USER",
    "value": "employee_user"
  },
  {
    "name": "DB_PASSWORD",
    "value": "employee123"
  },
  {
    "name": "DB_NAME",
    "value": "employee_db"
  }
]

}
