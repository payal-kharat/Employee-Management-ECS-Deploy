
pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select environment'
        )
    }

    environment {

        /* =====================================================
           AWS
           ===================================================== */

        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'

        ECR_REGISTRY =
            "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"


        /* =====================================================
           ECR REPOSITORIES
           ===================================================== */

        FRONTEND_REPOSITORY =
            'employee-management-frontend'

        BACKEND_REPOSITORY =
            'employee-management-backend'

        DB_REPOSITORY =
            'employee-managemet-db'


        /* =====================================================
           BACKEND BUILD
           ===================================================== */

        BUILD_CONTEXT =
            './backend'

        TASK_DEFINITION_TEMPLATE =
            './backend/task-definition.json'
    }


    stages {


        /* =====================================================
           DEV - BUILD AND PUSH
           ===================================================== */

        stage('DEV - Build and Push') {

            when {

                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }

            steps {

                script {

                    def commitId = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()


                    def imageTag =
                        "DEV-${commitId}"


                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.BACKEND_REPOSITORY}:${imageTag}"


                    echo "======================================"
                    echo "BUILDING BACKEND IMAGE"
                    echo "======================================"
                    echo "Environment : dev"
                    echo "Commit ID   : ${commitId}"
                    echo "Image Tag   : ${imageTag}"
                    echo "Image URI   : ${imageUri}"
                    echo "======================================"


                    sh """
                        set -e

                        aws ecr get-login-password \
                            --region ${env.AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin ${env.ECR_REGISTRY}


                        docker build \
                            -t ${imageUri} \
                            ${env.BUILD_CONTEXT}


                        docker push ${imageUri}
                    """


                    echo "======================================"
                    echo "BACKEND IMAGE BUILT AND PUSHED"
                    echo "======================================"
                    echo "Image: ${imageUri}"
                    echo "======================================"
                }
            }
        }


        /* =====================================================
           QA - PROMOTE IMAGE
           ===================================================== */

        stage('QA - Promote Image') {

            when {

                expression {
                    params.ENVIRONMENT == 'qa'
                }
            }

            steps {

                script {

                    /*
                     * Find the latest DEV image from ECR.
                     */

                    def sourceTag = sh(
                        script: """
                            aws ecr describe-images \
                                --repository-name ${env.BACKEND_REPOSITORY} \
                                --region ${env.AWS_REGION} \
                                --query 'sort_by(imageDetails,&imagePushedAt)[?imageTags && contains(join(`,`,imageTags), `DEV-`)] | [-1].imageTags[?starts_with(@, `DEV-`)] | [0]' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()


                    if (!sourceTag ||
                        sourceTag == 'None' ||
                        sourceTag == 'null') {

                        error(
                            "No DEV backend image found in ECR."
                        )
                    }


                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.BACKEND_REPOSITORY}:${sourceTag}"


                    def targetTag =
                        "QA-${sourceTag.replaceFirst('^DEV-', '')}"


                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.BACKEND_REPOSITORY}:${targetTag}"


                    echo "======================================"
                    echo "PROMOTING BACKEND IMAGE"
                    echo "======================================"
                    echo "Source : ${sourceImage}"
                    echo "Target : ${targetImage}"
                    echo "======================================"


                    sh """
                        set -e

                        aws ecr get-login-password \
                            --region ${env.AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin ${env.ECR_REGISTRY}


                        docker pull ${sourceImage}


                        docker tag \
                            ${sourceImage} \
                            ${targetImage}


                        docker push ${targetImage}
                    """


                    echo "Backend image promoted DEV -> QA"
                }
            }
        }


        /* =====================================================
           UAT - PROMOTE IMAGE
           ===================================================== */

        stage('UAT - Promote Image') {

            when {

                expression {
                    params.ENVIRONMENT == 'uat'
                }
            }

            steps {

                script {

                    /*
                     * Find the latest QA image from ECR.
                     */

                    def sourceTag = sh(
                        script: """
                            aws ecr describe-images \
                                --repository-name ${env.BACKEND_REPOSITORY} \
                                --region ${env.AWS_REGION} \
                                --query 'sort_by(imageDetails,&imagePushedAt)[?imageTags && contains(join(`,`,imageTags), `QA-`)] | [-1].imageTags[?starts_with(@, `QA-`)] | [0]' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()


                    if (!sourceTag ||
                        sourceTag == 'None' ||
                        sourceTag == 'null') {

                        error(
                            "No QA backend image found in ECR."
                        )
                    }


                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.BACKEND_REPOSITORY}:${sourceTag}"


                    def targetTag =
                        "UAT-${sourceTag.replaceFirst('^QA-', '')}"


                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.BACKEND_REPOSITORY}:${targetTag}"


                    echo "======================================"
                    echo "PROMOTING BACKEND IMAGE"
                    echo "======================================"
                    echo "Source : ${sourceImage}"
                    echo "Target : ${targetImage}"
                    echo "======================================"


                    sh """
                        set -e

                        aws ecr get-login-password \
                            --region ${env.AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin ${env.ECR_REGISTRY}


                        docker pull ${sourceImage}


                        docker tag \
                            ${sourceImage} \
                            ${targetImage}


                        docker push ${targetImage}
                    """


                    echo "Backend image promoted QA -> UAT"
                }
            }
        }


        /* =====================================================
           PROD - PROMOTE IMAGE
           ===================================================== */

        stage('PROD - Promote Image') {

            when {

                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }

            steps {

                script {

                    /*
                     * Find the latest UAT image from ECR.
                     */

                    def sourceTag = sh(
                        script: """
                            aws ecr describe-images \
                                --repository-name ${env.BACKEND_REPOSITORY} \
                                --region ${env.AWS_REGION} \
                                --query 'sort_by(imageDetails,&imagePushedAt)[?imageTags && contains(join(`,`,imageTags), `UAT-`)] | [-1].imageTags[?starts_with(@, `UAT-`)] | [0]' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()


                    if (!sourceTag ||
                        sourceTag == 'None' ||
                        sourceTag == 'null') {

                        error(
                            "No UAT backend image found in ECR."
                        )
                    }


                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.BACKEND_REPOSITORY}:${sourceTag}"


                    def targetTag =
                        "PROD-${sourceTag.replaceFirst('^UAT-', '')}"


                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.BACKEND_REPOSITORY}:${targetTag}"


                    echo "======================================"
                    echo "PROMOTING BACKEND IMAGE"
                    echo "======================================"
                    echo "Source : ${sourceImage}"
                    echo "Target : ${targetImage}"
                    echo "======================================"


                    sh """
                        set -e

                        aws ecr get-login-password \
                            --region ${env.AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin ${env.ECR_REGISTRY}


                        docker pull ${sourceImage}


                        docker tag \
                            ${sourceImage} \
                            ${targetImage}


                        docker push ${targetImage}
                    """


                    echo "Backend image promoted UAT -> PROD"
                }
            }
        }


        /* =====================================================
           CREATE TASK DEFINITION
           ===================================================== */

        stage('Create Task Definition') {

            steps {

                script {

                    /*
                     * Determine the image and ECS environment.
                     */

                    def environment =
                        params.ENVIRONMENT


                    def sourceTag


                    if (environment == 'dev') {

                        def commitId = sh(
                            script: 'git rev-parse --short=7 HEAD',
                            returnStdout: true
                        ).trim()

                        sourceTag =
                            "DEV-${commitId}"

                    } else if (environment == 'qa') {

                        sourceTag = sh(
                            script: """
                                aws ecr describe-images \
                                    --repository-name ${env.BACKEND_REPOSITORY} \
                                    --region ${env.AWS_REGION} \
                                    --query 'sort_by(imageDetails,&imagePushedAt)[?imageTags && contains(join(`,`,imageTags), `QA-`)] | [-1].imageTags[?starts_with(@, `QA-`)] | [0]' \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()

                    } else if (environment == 'uat') {

                        sourceTag = sh(
                            script: """
                                aws ecr describe-images \
                                    --repository-name ${env.BACKEND_REPOSITORY} \
                                    --region ${env.AWS_REGION} \
                                    --query 'sort_by(imageDetails,&imagePushedAt)[?imageTags && contains(join(`,`,imageTags), `UAT-`)] | [-1].imageTags[?starts_with(@, `UAT-`)] | [0]' \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()

                    } else if (environment == 'prod') {

                        sourceTag = sh(
                            script: """
                                aws ecr describe-images \
                                    --repository-name ${env.BACKEND_REPOSITORY} \
                                    --region ${env.AWS_REGION} \
                                    --query 'sort_by(imageDetails,&imagePushedAt)[?imageTags && contains(join(`,`,imageTags), `PROD-`)] | [-1].imageTags[?starts_with(@, `PROD-`)] | [0]' \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()
                    }


                    if (!sourceTag ||
                        sourceTag == 'None' ||
                        sourceTag == 'null') {

                        error(
                            "Could not determine backend image tag for ${environment}."
                        )
                    }


                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.BACKEND_REPOSITORY}:${sourceTag}"


                    echo "======================================"
                    echo "TASK DEFINITION"
                    echo "======================================"
                    echo "Environment : ${environment}"
                    echo "Image Tag   : ${sourceTag}"
                    echo "Image URI   : ${imageUri}"
                    echo "======================================"


                    sh """
                        set -e

                        ENVIRONMENT="${environment}" \
                        IMAGE_URI="${imageUri}" \
                        TASK_DEFINITION_TEMPLATE="${env.TASK_DEFINITION_TEMPLATE}" \
                        python3 - <<'PY'

import json
import os

input_file = os.environ["TASK_DEFINITION_TEMPLATE"]
output_file = "new-backend-task-definition.json"

environment = os.environ["ENVIRONMENT"]
image_uri = os.environ["IMAGE_URI"]

with open(input_file, "r") as f:
    task_definition = json.load(f)

task_definition["family"] = \
    f"employee-managemet-{environment}-backend"

for container in task_definition["containerDefinitions"]:

    if container["name"] == "backend":
        container["image"] = image_uri
        break

else:
    raise Exception(
        "Container named 'backend' was not found."
    )

with open(output_file, "w") as f:
    json.dump(task_definition, f, indent=2)

PY

                        echo "Generated backend task definition:"
                        cat new-backend-task-definition.json
                    """
                }
            }
        }


        /* =====================================================
           REGISTER AND UPDATE ECS
           ===================================================== */

        stage('Register and Update ECS Service') {

            steps {

                script {

                    def environment =
                        params.ENVIRONMENT


                    def cluster =
                        "employee-managemet-${environment}-cluster"


                    def service =
                        "employee-managemet-${environment}-backend-service"


                    def taskFamily =
                        "employee-managemet-${environment}-backend"


                    /*
                     * UAT uses employee-managemet-uat-*
                     * so the dynamic naming above is correct.
                     */


                    echo "======================================"
                    echo "ECS DEPLOYMENT"
                    echo "======================================"
                    echo "Environment : ${environment}"
                    echo "Cluster     : ${cluster}"
                    echo "Service     : ${service}"
                    echo "Task Family : ${taskFamily}"
                    echo "======================================"


                    /*
                     * Register task definition.
                     *
                     * IMPORTANT:
                     * Revision is stored in local Groovy variable.
                     *
                     * No NEW_REVISION environment variable.
                     */

                    def revision = sh(
                        script: """
                            set -e

                            aws ecs register-task-definition \
                                --cli-input-json file://new-backend-task-definition.json \
                                --region ${env.AWS_REGION} \
                                --query 'taskDefinition.revision' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()


                    echo "AWS REGISTERED REVISION = '${revision}'"


                    if (!revision ||
                        revision == 'null' ||
                        revision == 'None') {

                        error(
                            "Invalid ECS revision returned by AWS: '${revision}'"
                        )
                    }


                    echo "Updating ECS service..."


                    sh """
                        set -e

                        aws ecs update-service \
                            --cluster ${cluster} \
                            --service ${service} \
                            --task-definition ${taskFamily}:${revision} \
                            --force-new-deployment \
                            --region ${env.AWS_REGION}
                    """


                    echo "Waiting for ECS service to become stable..."


                    sh """
                        set -e

                        aws ecs wait services-stable \
                            --cluster ${cluster} \
                            --services ${service} \
                            --region ${env.AWS_REGION}
                    """


                    echo "======================================"
                    echo "BACKEND ECS DEPLOYMENT COMPLETED"
                    echo "======================================"
                    echo "Environment : ${environment}"
                    echo "Cluster     : ${cluster}"
                    echo "Service     : ${service}"
                    echo "Task Family : ${taskFamily}"
                    echo "Revision    : ${revision}"
                    echo "======================================"
                }
            }
        }
    }


    /* =========================================================
       POST
       ========================================================= */

    post {

        always {

            echo "Cleaning Jenkins workspace..."

            cleanWs()
        }
    }
}
