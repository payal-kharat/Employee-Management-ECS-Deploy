{
  "containerDefinitions": [
    {
      "name": "db",
      "image": "552940445807.dkr.ecr.us-east-1.amazonaws.com/employee-mgm-${ENV}-db:${COMMIT_ID}",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3306,
          "hostPort": 3306,
          "protocol": "tcp",
          "name": "mysql"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "MYSQL_DATABASE",
          "value": "employee_db"
        },
        {
          "name": "MYSQL_USER",
          "value": "employee_user"
        },
        {
          "name": "MYSQL_PASSWORD",
          "value": "***********"
        },
        {
          "name": "MYSQL_ROOT_PASSWORD",
          "value": "*************"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/employee-mgm-${ENV}-db",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "family": "employee-mgm-${ENV}-db",
  "executionRoleArn": "arn:aws:iam::552940445807:role/employee-mgm-${ENV}-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::552940445807:role/employee-mgm-${ENV}-ecs-task-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
