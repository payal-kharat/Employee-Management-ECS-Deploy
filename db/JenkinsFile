
pipeline {
    agent any

    parameters {
        choice(
            name: 'Environment',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the deployment environment'
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Existing DEV image tag to promote. Required for QA/UAT/PROD.'
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'
        AWS_CRED = 'AWS'
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REGISTRY_URL = "https://${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        DEV_REPO = 'employee-mgm-dev-db'
        QA_REPO = 'employee-mgm-qa-db'
        UAT_REPO = 'employee-mgm-uat-db'
        PROD_REPO = 'employee-mgm-prod-db'
        BUILD_CONTEXT = './db'
        DB_DOCKERFILE = './db/Dockerfile'
        TASK_DEFINITION_FILE = './db/task-definition.json'
    }

    stages {
        stage('Get ECS Cluster') {
            steps {
                script {
                    env.ECS_CLUSTER = getECSCluster(params.Environment)
                    echo "ECS_CLUSTER = ${env.ECS_CLUSTER}"
                }
            }
        }

        stage('Dev - Build & Push DB') {
            when {
                expression { params.Environment == 'dev' }
            }
            steps {
                script {
                    def commitId = getCommitId()
                    env.DEV_IMAGE_TAG = "DEV-${commitId}-${env.BUILD_NUMBER}"
                    buildAndPush(env.DEV_REPO, env.BUILD_CONTEXT)
                }
            }
        }

        stage('Promote Database Dev to QA') {
            when {
                expression { params.Environment in ['qa', 'uat', 'prod'] }
            }
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim() || !params.IMAGE_TAG.startsWith('DEV-')) {
                        error('Provide a valid existing DEV image tag, for example DEV-a1b2c3d-25.')
                    }

                    env.DEV_IMAGE_TAG = params.IMAGE_TAG.trim()

                    promoteImage(
                        env.DEV_REPO,
                        env.QA_REPO,
                        env.DEV_IMAGE_TAG,
                        'QA'
                    )

                    env.QA_IMAGE_TAG = "QA-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                }
            }
        }

        stage('Promote Database QA to UAT') {
            when {
                expression { params.Environment in ['uat', 'prod'] }
            }
            steps {
                script {
                    promoteImage(
                        env.QA_REPO,
                        env.UAT_REPO,
                        env.QA_IMAGE_TAG,
                        'UAT'
                    )

                    env.UAT_IMAGE_TAG = "UAT-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                }
            }
        }

        stage('Production Approval') {
            when {
                expression { params.Environment == 'prod' }
            }
            steps {
                input(
                    message: 'DEV → QA → UAT DB promotion completed. Deploy Employee Management DB to PROD?',
                    ok: 'Deploy to PROD'
                )
            }
        }

        stage('Promote Database UAT to PROD') {
            when {
                expression { params.Environment == 'prod' }
            }
            steps {
                script {
                    promoteImage(
                        env.UAT_REPO,
                        env.PROD_REPO,
                        env.UAT_IMAGE_TAG,
                        'PROD'
                    )

                    env.PROD_IMAGE_TAG = "PROD-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                }
            }
        }

        stage('Deploy DB') {
            steps {
                script {
                    def taskFamily = getTaskFamily(params.Environment)
                    def ecsService = getECSService(params.Environment)

                    deployToECS(
                        env.TASK_DEFINITION_FILE,
                        taskFamily,
                        ecsService
                    )
                }
            }
        }
    }

    post {
        always {
            deleteDir()
        }
    }
}

def getCommitId() {
    return sh(
        script: 'git rev-parse --short=7 HEAD',
        returnStdout: true
    ).trim()
}

def buildAndPush(String DB_IMAGE, String BUILD_CONTEXT) {
    def IMAGE_URI = "${env.ECR_REGISTRY}/${DB_IMAGE}:${env.DEV_IMAGE_TAG}"

    echo "Building image: ${IMAGE_URI}"

    def image = docker.build(
        IMAGE_URI,
        "-f ${env.DB_DOCKERFILE} ${BUILD_CONTEXT}"
    )

    docker.withRegistry(
        env.ECR_REGISTRY_URL,
        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
    ) {
        image.push()
    }

    echo 'DB image pushed successfully.'
}

def promoteImage(
    String sourceRepository,
    String targetRepository,
    String sourceTag,
    String targetEnvironment
) {
    def sourceImage = "${env.ECR_REGISTRY}/${sourceRepository}:${sourceTag}"
    def targetTag = "${targetEnvironment}-${sourceTag.replaceFirst('^DEV-', '')}"
    def targetImage = "${env.ECR_REGISTRY}/${targetRepository}:${targetTag}"

    echo "Source image: ${sourceImage}"
    echo "Target image: ${targetImage}"

    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: env.AWS_CRED
        ]
    ]) {
        docker.withRegistry(
            env.ECR_REGISTRY_URL,
            "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
        ) {
            docker.image(sourceImage).pull()
        }

        sh """
            docker tag '${sourceImage}' '${targetImage}'
        """

        docker.withRegistry(
            env.ECR_REGISTRY_URL,
            "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
        ) {
            docker.image(targetImage).push()
        }
    }

    echo 'DB image promoted successfully.'
}

def deployToECS(
    String taskDefinitionFile,
    String taskFamily,
    String ecsService
) {
    def selectedEnvironment = params.Environment
    def imageTag = getImageTag(selectedEnvironment)
    def region = env.AWS_REGION
    def cluster = getECSCluster(selectedEnvironment)

    // Resolve the selected environment's current Secrets Manager ARN.
    def secretName = "employee-mgm-${selectedEnvironment}-secrets"
    def renderedTaskDefinition = taskDefinitionFile.replace(
        '.json',
        '-rendered.json'
    )

    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: env.AWS_CRED
        ]
    ]) {
        def secretArn = sh(
            script: """
                set -e
                aws secretsmanager describe-secret \
                    --secret-id '${secretName}' \
                    --region '${region}' \
                    --query ARN \
                    --output text
            """,
            returnStdout: true
        ).trim()

        if (!secretArn.startsWith('arn:aws:secretsmanager:')) {
            error("Could not resolve a valid Secrets Manager ARN for ${secretName}.")
        }

        echo "Environment: ${selectedEnvironment}"
        echo "Secret name: ${secretName}"
        echo 'Secrets Manager ARN resolved successfully.'

        withEnv([
            "DEPLOY_ENV=${selectedEnvironment}",
            "DEPLOY_IMAGE_TAG=${imageTag}",
            "SECRET_ARN_VALUE=${secretArn}",
            "TASK_DEF_TEMPLATE=${taskDefinitionFile}",
            "TASK_DEF_RENDERED=${renderedTaskDefinition}"
        ]) {
            sh '''
                set -e

                test -f "$TASK_DEF_TEMPLATE"

                sed \
                    -e 's|\\${ENV}|'"$DEPLOY_ENV"'|g' \
                    -e 's|\\${COMMIT_ID}|'"$DEPLOY_IMAGE_TAG"'|g' \
                    -e 's|\\${SECRET_ARN}|'"$SECRET_ARN_VALUE"'|g' \
                    "$TASK_DEF_TEMPLATE" > "$TASK_DEF_RENDERED"

                echo "Checking rendered task definition..."

                grep '"family"' "$TASK_DEF_RENDERED"
                grep '"image"' "$TASK_DEF_RENDERED"

                if grep -q '\\${SECRET_ARN}' "$TASK_DEF_RENDERED"; then
                    echo "ERROR: SECRET_ARN placeholder was not replaced."
                    exit 1
                fi
            '''
        }

        echo 'Registering ECS task definition...'

        def taskRevision = sh(
            script: """
                aws ecs register-task-definition \
                    --cli-input-json file://${renderedTaskDefinition} \
                    --region ${region} \
                    --query 'taskDefinition.revision' \
                    --output text
            """,
            returnStdout: true
        ).trim()

        echo "Task definition revision: ${taskRevision}"

        echo 'Updating ECS service...'

        sh """
            aws ecs update-service \
                --cluster '${cluster}' \
                --service '${ecsService}' \
                --task-definition '${taskFamily}:${taskRevision}' \
                --region '${region}'
        """

        echo 'ECS deployment update submitted successfully.'
    }
}

def getECSCluster(String environment) {
    def clusters = [
        dev: 'employee-mgm-dev-cluster',
        qa: 'employee-mgm-qa-cluster',
        uat: 'employee-mgm-uat-cluster',
        prod: 'employee-mgm-prod-cluster'
    ]

    return clusters[environment]
}

def getTaskFamily(String environment) {
    def taskFamilies = [
        dev: 'employee-mgm-dev-db',
        qa: 'employee-mgm-qa-db',
        uat: 'employee-mgm-uat-db',
        prod: 'employee-mgm-prod-db'
    ]

    return taskFamilies[environment]
}

def getECSService(String environment) {
    def services = [
        dev: 'employee-mgm-dev-db-service',
        qa: 'employee-mgm-qa-db-service',
        uat: 'employee-mgm-uat-db-service',
        prod: 'employee-mgm-prod-db-service'
    ]

    return services[environment]
}

def getRepository(String environment) {
    def repositories = [
        dev: env.DEV_REPO,
        qa: env.QA_REPO,
        uat: env.UAT_REPO,
        prod: env.PROD_REPO
    ]

    return repositories[environment]
}

def getImageTag(String environment) {
    def imageTags = [
        dev: env.DEV_IMAGE_TAG,
        qa: env.QA_IMAGE_TAG,
        uat: env.UAT_IMAGE_TAG,
        prod: env.PROD_IMAGE_TAG
    ]

    return imageTags[environment]
}