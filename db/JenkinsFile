
pipeline {

    agent any

    parameters {

        choice(
            name: 'Environment',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the deployment environment'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Existing DEV image tag to promote. Required for QA/UAT/PROD.'
        )
    }

    environment {

        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'
        AWS_CRED = 'AWS'
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        DEV_REPO  = 'employee-mgm-dev-db'
        QA_REPO   = 'employee-mgm-qa-db'
        UAT_REPO  = 'employee-mgm-uat-db'
        PROD_REPO = 'employee-mgm-prod-db'

        BUILD_CONTEXT = './db'
        TASK_DEFINITION_TEMPLATE = './db/task-definition.json'
    }


    stages {
        stage('Validate Parameters') {

            steps {

                script {

                    echo "============================================================"
                    echo "SELECTED ENVIRONMENT : ${params.Environment}"
                    echo "IMAGE TAG            : ${params.IMAGE_TAG}"
                    echo "============================================================"


                    if (
                        params.Environment in ['qa', 'uat', 'prod'] &&
                        !params.IMAGE_TAG?.trim()
                    ) {

                        error(
                            "IMAGE_TAG is required when Environment is " +
                            "${params.Environment}. " +
                            "Provide an existing DEV image tag such as " +
                            "DEV-cff5bc9-14."
                        )
                    }


                    if (
                        params.Environment in ['qa', 'uat', 'prod'] &&
                        !params.IMAGE_TAG.startsWith('DEV-')
                    ) {

                        error(
                            "IMAGE_TAG must be an existing DEV image tag. " +
                            "Example: DEV-cff5bc9-14"
                        )
                    }
                }
            }
        }


        stage('Checkout') {

            steps {

                checkout scm

                script {

                    env.COMMIT_ID =
                        sh(
                            script: 'git rev-parse --short=7 HEAD',
                            returnStdout: true
                        ).trim()


                    echo "======================================"
                    echo "COMMIT ID = ${env.COMMIT_ID}"
                    echo "======================================"
                }
            }
        }


        stage('DEV - Build Image') {

            when {

                expression {

                    params.Environment == 'dev'
                }
            }

            steps {

                script {

                    def imageTag ="DEV-${env.COMMIT_ID}-${env.BUILD_NUMBER}"
                    env.DEV_IMAGE_TAG = imageTag
                    def imageUri ="${env.ECR_REGISTRY}/${env.DEV_REPO}:${imageTag}"
                    env.DEV_IMAGE_URI = imageUri


                    echo "======================================"
                    echo "BUILD ENVIRONMENT = DEV"
                    echo "COMMIT ID         = ${env.COMMIT_ID}"
                    echo "IMAGE TAG         = ${imageTag}"
                    echo "DEV REPOSITORY    = ${env.DEV_REPO}"
                    echo "IMAGE URI         = ${imageUri}"
                    echo "======================================"


                    echo "Building Employee Management DB Docker image..."


                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.build(
                            imageUri,
                            env.BUILD_CONTEXT
                        )
                    }


                    echo "Employee Management DB Docker image built successfully."
                }
            }
        }


        stage('DEV - Push Image') {

            when {

                expression {

                    params.Environment == 'dev'
                }
            }

            steps {

                script {

                    if (!env.DEV_IMAGE_URI?.trim()) {

                        error(
                            "DEV_IMAGE_URI is empty. " +
                            "DEV image was not built successfully."
                        )
                    }


                    echo "======================================"
                    echo "PUSHING EMPLOYEE MANAGEMENT DB IMAGE"
                    echo "DEV REPOSITORY = ${env.DEV_REPO}"
                    echo "IMAGE URI       = ${env.DEV_IMAGE_URI}"
                    echo "======================================"


                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.image(
                            env.DEV_IMAGE_URI
                        ).push()
                    }


                    echo "Employee Management DB DEV image pushed successfully."
                }
            }
        }


        stage('Promote DEV to QA') {

            when {

                expression {

                    params.Environment in ['qa', 'uat', 'prod']
                }
            }

            steps {

                script {

                    env.DEV_IMAGE_TAG =
                        params.IMAGE_TAG


                    promoteImage(
                        env.DEV_REPO,
                        env.QA_REPO,
                        env.DEV_IMAGE_TAG,
                        'QA'
                    )


                    env.QA_IMAGE_TAG ="QA-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                    env.QA_IMAGE_URI ="${env.ECR_REGISTRY}/${env.QA_REPO}:${env.QA_IMAGE_TAG}"


                    echo "============================================================"
                    echo "DEV → QA PROMOTION COMPLETED"
                    echo "DEV IMAGE : ${env.DEV_IMAGE_URI}"
                    echo "QA IMAGE  : ${env.QA_IMAGE_URI}"
                    echo "============================================================"
                }
            }
        }


        stage('Promote QA to UAT') {

            when {

                expression {

                    params.Environment in ['uat', 'prod']
                }
            }

            steps {

                script {

                    promoteImage(
                        env.QA_REPO,
                        env.UAT_REPO,
                        env.QA_IMAGE_TAG,
                        'UAT'
                    )


                    env.UAT_IMAGE_TAG ="UAT-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                    env.UAT_IMAGE_URI ="${env.ECR_REGISTRY}/${env.UAT_REPO}:${env.UAT_IMAGE_TAG}"


                    echo "============================================================"
                    echo "QA → UAT PROMOTION COMPLETED"
                    echo "QA IMAGE  : ${env.QA_IMAGE_URI}"
                    echo "UAT IMAGE : ${env.UAT_IMAGE_URI}"
                    echo "============================================================"
                }
            }
        }


        stage('Promote UAT to PROD') {

            when {

                expression {

                    params.Environment == 'prod'
                }
            }

            steps {

                script {

                    promoteImage(
                        env.UAT_REPO,
                        env.PROD_REPO,
                        env.UAT_IMAGE_TAG,
                        'PROD'
                    )


                    env.PROD_IMAGE_TAG ="PROD-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                    env.PROD_IMAGE_URI ="${env.ECR_REGISTRY}/${env.PROD_REPO}:${env.PROD_IMAGE_TAG}"


                    echo "============================================================"
                    echo "UAT → PROD PROMOTION COMPLETED"
                    echo "UAT IMAGE  : ${env.UAT_IMAGE_URI}"
                    echo "PROD IMAGE : ${env.PROD_IMAGE_URI}"
                    echo "============================================================"
                }
            }
        }


        stage('Deploy DB - DEV') {

            when {

                expression {

                    params.Environment == 'dev'
                }
            }

            steps {

                script {

                    deployDB(
                        'dev',
                        env.DEV_REPO,
                        env.DEV_IMAGE_TAG
                    )
                }
            }
        }


        stage('Deploy DB - QA') {

            when {

                expression {

                    params.Environment == 'qa'
                }
            }

            steps {

                script {

                    deployDB(
                        'qa',
                        env.QA_REPO,
                        env.QA_IMAGE_TAG
                    )
                }
            }
        }


        stage('Deploy DB - UAT') {

            when {

                expression {

                    params.Environment == 'uat'
                }
            }

            steps {

                script {

                    deployDB(
                        'uat',
                        env.UAT_REPO,
                        env.UAT_IMAGE_TAG
                    )
                }
            }
        }


        stage('Production Approval') {

            when {

                expression {

                    params.Environment == 'prod'
                }
            }

            steps {

                input(
                    message:
                        'DEV → QA → UAT DB promotion completed. Deploy Employee Management DB to PROD?',
                    ok:
                        'Deploy to PROD'
                )
            }
        }


        stage('Deploy DB - PROD') {

            when {

                expression {

                    params.Environment == 'prod'
                }
            }

            steps {

                script {

                    deployDB(
                        'prod',
                        env.PROD_REPO,
                        env.PROD_IMAGE_TAG
                    )
                }
            }
        }
    }


    post {

        always {

            echo 'Cleaning Jenkins workspace...'

            cleanWs()
        }


        success {

            echo '''
============================================================
EMPLOYEE MANAGEMENT DB ECS CI/CD completed successfully.

DEV → QA → UAT → PROD
============================================================
'''
        }


        failure {

            echo '''
============================================================
EMPLOYEE MANAGEMENT DB ECS CI/CD FAILED.

Check the Jenkins console output.
============================================================
'''
        }
    }
}


def promoteImage(
    String sourceRepo,
    String targetRepo,
    String sourceTag,
    String targetEnvironment
) {

    def sourceImage="${env.ECR_REGISTRY}/${sourceRepo}:${sourceTag}"
    def targetTag ="${targetEnvironment}-${sourceTag.replaceFirst('^DEV-', '')}"
    def targetImage ="${env.ECR_REGISTRY}/${targetRepo}:${targetTag}"


    echo "============================================================"
    echo "PROMOTING EMPLOYEE MANAGEMENT DB IMAGE"
    echo "============================================================"
    echo "SOURCE REPOSITORY : ${sourceRepo}"
    echo "SOURCE IMAGE      : ${sourceImage}"
    echo "TARGET REPOSITORY : ${targetRepo}"
    echo "TARGET IMAGE      : ${targetImage}"
    echo "============================================================"


    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]
    ]) {

        sh """
            set -e

            echo "AWS Identity:"
            aws sts get-caller-identity


            echo "Logging in to ECR..."


            aws ecr get-login-password \
                --region ${env.AWS_REGION} \
                | docker login \
                    --username AWS \
                    --password-stdin ${env.ECR_REGISTRY}


            echo "Pulling source image..."

            docker pull ${sourceImage}


            echo "Tagging image..."

            docker tag \
                ${sourceImage} \
                ${targetImage}


            echo "Pushing promoted image..."

            docker push ${targetImage}


            echo "============================================================"
            echo "PROMOTION COMPLETED"
            echo "SOURCE IMAGE : ${sourceImage}"
            echo "TARGET IMAGE : ${targetImage}"
            echo "============================================================"
        """
    }
}


def deployDB(
    String environment,
    String repository,
    String imageTag
) {

    def imageUri ="${env.ECR_REGISTRY}/${repository}:${imageTag}"
    def taskDefinitionFile = "new-db-task-definition-${environment}.json"


    echo "============================================================"
    echo "DEPLOYING EMPLOYEE MANAGEMENT DB"
    echo "============================================================"
    echo "Environment : ${environment}"
    echo "Repository  : ${repository}"
    echo "Image Tag   : ${imageTag}"
    echo "Image URI   : ${imageUri}"
    echo "============================================================"


    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]
    ]) {

        sh """
            set -e

            echo "AWS Identity:"

            aws sts get-caller-identity


            echo "Creating ECS task definition for ${environment}..."


            ENVIRONMENT="${environment}" \
            IMAGE_URI="${imageUri}" \
            TASK_DEFINITION_TEMPLATE="${env.TASK_DEFINITION_TEMPLATE}" \
            OUTPUT_FILE="${taskDefinitionFile}" \
            python3 - <<'PYTHON'

import json
import os


input_file = os.environ["TASK_DEFINITION_TEMPLATE"]
output_file = os.environ["OUTPUT_FILE"]
environment = os.environ["ENVIRONMENT"]
image_uri = os.environ["IMAGE_URI"]


with open(input_file, "r") as f:

    task_definition = json.load(f)


task_definition["family"] = \
    f"employee-mgm-{environment}-db"


container_found = False


for container in task_definition["containerDefinitions"]:

    if container["name"] == "db":

        container["image"] = image_uri

        container_found = True

        break


if not container_found:

    raise Exception(
        "Container named 'db' was not found."
    )


remove_fields = [
    "taskDefinitionArn",
    "revision",
    "status",
    "requiresAttributes",
    "compatibilities",
    "registeredAt",
    "registeredBy"
]


for field in remove_fields:

    task_definition.pop(
        field,
        None
    )


with open(output_file, "w") as f:

    json.dump(
        task_definition,
        f,
        indent=2
    )


print("Task definition created:")
print(output_file)


print("DB image:")
print(image_uri)

PYTHON


            echo "Generated task definition:"

            cat ${taskDefinitionFile}

            echo "Registering ECS task definition..."

            REVISION=\$(aws ecs register-task-definition \
                --cli-input-json file://${taskDefinitionFile} \
                --region ${env.AWS_REGION} \
                --query 'taskDefinition.revision' \
                --output text)


            echo "AWS REGISTERED REVISION = \$REVISION"


            if [ -z "\$REVISION" ] || \
               [ "\$REVISION" = "null" ] || \
               [ "\$REVISION" = "None" ]; then

                echo "ERROR: ECS returned invalid revision."

                exit 1

            fi


            echo "Updating ECS DB service..."

            aws ecs update-service \
                --cluster employee-mgm-${environment}-cluster \
                --service employee-mgm-${environment}-db-service \
                --task-definition employee-mgm-${environment}-db:\$REVISION \
                --force-new-deployment \
                --region ${env.AWS_REGION}

            echo "Waiting for ECS DB service to become stable..."
            aws ecs wait services-stable \
                --cluster employee-mgm-${environment}-cluster \
                --services employee-mgm-${environment}-db-service \
                --region ${env.AWS_REGION}


            echo "============================================================"
            echo "EMPLOYEE MANAGEMENT DB ${environment} deployment completed."
            echo "Image: ${imageUri}"
            echo "============================================================"
        """
    }
}

