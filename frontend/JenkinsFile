pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select environment'
        )
    }

    environment {

        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'

        ECR_REGISTRY =
            "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        FRONTEND_REPOSITORY =
            'employee-managemet-frontend'

        BUILD_CONTEXT =
            './frontend'

        TASK_DEFINITION_TEMPLATE =
            './frontend/task-definition.json'
    }

    stages {

        /*
         * ============================================================
         * 1. DEV - BUILD AND PUSH
         * ============================================================
         */

        stage('DEV - Build and Push') {

            when {
                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }

            steps {

                script {

                    def commitId = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()

                    def imageTag =
                        "DEV-${commitId}"

                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.FRONTEND_REPOSITORY}:${imageTag}"

                    echo "ENVIRONMENT = dev"
                    echo "IMAGE TAG = ${imageTag}"
                    echo "IMAGE URI = ${imageUri}"

                    sh """
                        set -e

                        echo "Logging in to ECR..."

                        aws ecr get-login-password \
                            --region ${env.AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin ${env.ECR_REGISTRY}

                        echo "Building frontend Docker image..."

                        docker build \
                            -t ${imageUri} \
                            ${env.BUILD_CONTEXT}

                        echo "Pushing frontend Docker image..."

                        docker push ${imageUri}
                    """
                }
            }
        }


        /*
         * ============================================================
         * 2. QA - PROMOTE IMAGE
         * ============================================================
         */

        stage('QA - Promote Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'qa'
                }
            }

            steps {

                script {

                    def sourceTag = sh(
                        script: """
                            aws ecr describe-images \
                                --repository-name ${env.FRONTEND_REPOSITORY} \
                                --region ${env.AWS_REGION} \
                                --filter tagStatus=TAGGED \
                                --query 'sort_by(imageDetails,&imagePushedAt)[-1].imageTags[?starts_with(@, \\`DEV-\\`)] | [0]' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (!sourceTag ||
                        sourceTag == 'None' ||
                        sourceTag == 'null') {

                        error("No DEV frontend image found in ECR.")
                    }

                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.FRONTEND_REPOSITORY}:${sourceTag}"

                    def targetTag =
                        "QA-${sourceTag.replaceFirst('^DEV-', '')}"

                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.FRONTEND_REPOSITORY}:${targetTag}"

                    echo "SOURCE IMAGE = ${sourceImage}"
                    echo "TARGET IMAGE = ${targetImage}"

                    sh """
                        set -e

                        echo "Logging in to ECR..."

                        aws ecr get-login-password \
                            --region ${env.AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin ${env.ECR_REGISTRY}

                        echo "Pulling DEV image..."

                        docker pull ${sourceImage}

                        echo "Tagging image for QA..."

                        docker tag \
                            ${sourceImage} \
                            ${targetImage}

                        echo "Pushing QA image..."

                        docker push ${targetImage}
                    """

                    env.IMAGE_URI = targetImage
                }
            }
        }


        /*
         * ============================================================
         * 3. UAT - PROMOTE IMAGE
         * ============================================================
         */

        stage('UAT - Promote Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'uat'
                }
            }

            steps {

                script {

                    def sourceTag = sh(
                        script: """
                            aws ecr describe-images \
                                --repository-name ${env.FRONTEND_REPOSITORY} \
                                --region ${env.AWS_REGION} \
                                --filter tagStatus=TAGGED \
                                --query 'sort_by(imageDetails,&imagePushedAt)[-1].imageTags[?starts_with(@, \\`DEV-\\`)] | [0]' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (!sourceTag ||
                        sourceTag == 'None' ||
                        sourceTag == 'null') {

                        error("No DEV frontend image found in ECR.")
                    }

                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.FRONTEND_REPOSITORY}:${sourceTag}"

                    def targetTag =
                        "UAT-${sourceTag.replaceFirst('^DEV-', '')}"

                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.FRONTEND_REPOSITORY}:${targetTag}"

                    echo "SOURCE IMAGE = ${sourceImage}"
                    echo "TARGET IMAGE = ${targetImage}"

                    sh """
                        set -e

                        echo "Logging in to ECR..."

                        aws ecr get-login-password \
                            --region ${env.AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin ${env.ECR_REGISTRY}

                        echo "Pulling DEV image..."

                        docker pull ${sourceImage}

                        echo "Tagging image for UAT..."

                        docker tag \
                            ${sourceImage} \
                            ${targetImage}

                        echo "Pushing UAT image..."

                        docker push ${targetImage}
                    """

                    env.IMAGE_URI = targetImage
                }
            }
        }


        /*
         * ============================================================
         * 4. PROD - PROMOTE IMAGE
         * ============================================================
         */

        stage('PROD - Promote Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }

            steps {

                script {

                    def sourceTag = sh(
                        script: """
                            aws ecr describe-images \
                                --repository-name ${env.FRONTEND_REPOSITORY} \
                                --region ${env.AWS_REGION} \
                                --filter tagStatus=TAGGED \
                                --query 'sort_by(imageDetails,&imagePushedAt)[-1].imageTags[?starts_with(@, \\`DEV-\\`)] | [0]' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (!sourceTag ||
                        sourceTag == 'None' ||
                        sourceTag == 'null') {

                        error("No DEV frontend image found in ECR.")
                    }

                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.FRONTEND_REPOSITORY}:${sourceTag}"

                    def targetTag =
                        "PROD-${sourceTag.replaceFirst('^DEV-', '')}"

                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.FRONTEND_REPOSITORY}:${targetTag}"

                    echo "SOURCE IMAGE = ${sourceImage}"
                    echo "TARGET IMAGE = ${targetImage}"

                    sh """
                        set -e

                        echo "Logging in to ECR..."

                        aws ecr get-login-password \
                            --region ${env.AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin ${env.ECR_REGISTRY}

                        echo "Pulling DEV image..."

                        docker pull ${sourceImage}

                        echo "Tagging image for PROD..."

                        docker tag \
                            ${sourceImage} \
                            ${targetImage}

                        echo "Pushing PROD image..."

                        docker push ${targetImage}
                    """

                    env.IMAGE_URI = targetImage
                }
            }
        }


        /*
         * ============================================================
         * 5. CREATE TASK DEFINITION
         * ============================================================
         */

        stage('Create Task Definition') {

            steps {

                script {

                    if (!env.IMAGE_URI?.trim()) {

                        error(
                            "IMAGE_URI is empty. " +
                            "Make sure the image build/promote stage ran successfully."
                        )
                    }

                    echo "ENVIRONMENT = ${params.ENVIRONMENT}"
                    echo "IMAGE URI = ${env.IMAGE_URI}"

                    sh """
                        set -e

                        ENVIRONMENT="${params.ENVIRONMENT}" \
                        IMAGE_URI="${env.IMAGE_URI}" \
                        TASK_DEFINITION_TEMPLATE="${env.TASK_DEFINITION_TEMPLATE}" \
                        python3 - <<'PY'

import json
import os

input_file = os.environ["TASK_DEFINITION_TEMPLATE"]
output_file = "new-frontend-task-definition.json"

environment = os.environ["ENVIRONMENT"]
image_uri = os.environ["IMAGE_URI"]

with open(input_file, "r") as f:
    task_definition = json.load(f)

task_definition["family"] = \
    f"employee-managemet-{environment}-frontend"

for container in task_definition["containerDefinitions"]:

    if container["name"] == "frontend":
        container["image"] = image_uri
        break

else:
    raise Exception(
        "Container named 'frontend' was not found."
    )

with open(output_file, "w") as f:
    json.dump(task_definition, f, indent=2)

PY

                        echo "Generated frontend task definition:"

                        cat new-frontend-task-definition.json
                    """
                }
            }
        }


        /*
         * ============================================================
         * 6. REGISTER AND UPDATE ECS SERVICE
         * ============================================================
         */

        stage('Register and Update ECS Service') {

            steps {

                script {

                    def revision = sh(
                        script: """
                            set -e

                            aws ecs register-task-definition \
                                --cli-input-json file://new-frontend-task-definition.json \
                                --region ${env.AWS_REGION} \
                                --query 'taskDefinition.revision' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    echo "AWS REGISTERED REVISION = '${revision}'"

                    if (!revision ||
                        revision == 'null' ||
                        revision == 'None') {

                        error(
                            "ECS returned invalid revision: '${revision}'"
                        )
                    }

                    def environment =
                        params.ENVIRONMENT

                    def cluster =
                        "employee-managemet-${environment}-cluster"

                    def service =
                        "employee-managemet-${environment}-frontend-service"

                    def taskFamily =
                        "employee-managemet-${environment}-frontend"

                    echo "ENVIRONMENT = ${environment}"
                    echo "CLUSTER = ${cluster}"
                    echo "SERVICE = ${service}"
                    echo "TASK FAMILY = ${taskFamily}"
                    echo "TASK REVISION = ${revision}"

                    sh """
                        set -e

                        echo "Updating ECS service..."

                        aws ecs update-service \
                            --cluster ${cluster} \
                            --service ${service} \
                            --task-definition ${taskFamily}:${revision} \
                            --force-new-deployment \
                            --region ${env.AWS_REGION}

                        echo "Waiting for ECS service to become stable..."

                        aws ecs wait services-stable \
                            --cluster ${cluster} \
                            --services ${service} \
                            --region ${env.AWS_REGION}

                        echo "Frontend ECS deployment completed successfully."
                    """
                }
            }
        }
    }


    /*
     * ================================================================
     * POST
     * ================================================================
     */

    post {

        always {

            echo "Cleaning Jenkins workspace..."

            cleanWs()
        }
    }
}
