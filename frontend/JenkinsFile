
pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the environment to deploy'
        )

        string(
            name: 'DEV_IMAGE_TAG',
            defaultValue: '',
            description: 'For QA/UAT/PROD enter the existing DEV image tag, e.g. DEV-a1b2c3d-25'
        )
    }


    environment {

        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'

        AWS_CRED = 'AWS'
        ECR_REGISTRY ="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"


        DEV_REPO  = 'employee-mgm-dev-frontend'
        QA_REPO   = 'employee-mgm-qa-frontend'
        UAT_REPO  = 'employee-mgm-uat-frontend'
        PROD_REPO = 'employee-mgm-prod-frontend'


        BUILD_CONTEXT ='./frontend'
        TASK_DEFINITION_TEMPLATE = './frontend/task-definition.json'
    }


    stages {
        stage('Validate Parameters') {

            steps {

                script {

                    echo "============================================================"
                    echo "ENVIRONMENT : ${params.ENVIRONMENT}"
                    echo "DEV TAG     : ${params.DEV_IMAGE_TAG}"
                    echo "============================================================"


                    if (
                        params.ENVIRONMENT in ['qa', 'uat', 'prod'] &&
                        !params.DEV_IMAGE_TAG?.trim()
                    ) {

                        error(
                            "DEV_IMAGE_TAG is required for " +
                            "${params.ENVIRONMENT}. " +
                            "Example: DEV-a1b2c3d-25"
                        )
                    }


                    if (
                        params.ENVIRONMENT in ['qa', 'uat', 'prod'] &&
                        !params.DEV_IMAGE_TAG.startsWith('DEV-')
                    ) {

                        error(
                            "DEV_IMAGE_TAG must be an existing DEV image tag. " +
                            "Example: DEV-a1b2c3d-25"
                        )
                    }
                }
            }
        }


        stage('Checkout') {

            steps {

                checkout scm

                script {

                    env.COMMIT_ID =
                        sh(
                            script: 'git rev-parse --short=7 HEAD',
                            returnStdout: true
                        ).trim()


                    echo "======================================"
                    echo "COMMIT ID   = ${env.COMMIT_ID}"
                    echo "ENVIRONMENT = ${params.ENVIRONMENT}"
                    echo "DEV TAG     = ${params.DEV_IMAGE_TAG}"
                    echo "======================================"
                }
            }
        }


        stage('DEV - Build Image') {

            when {

                expression {

                    params.ENVIRONMENT == 'dev'
                }
            }

            steps {

                script {

                    def imageTag ="DEV-${env.COMMIT_ID}-${env.BUILD_NUMBER}"
                    env.DEV_IMAGE_TAG =  imageTag
                    def imageUri ="${env.ECR_REGISTRY}/${env.DEV_REPO}:${imageTag}"

                    env.DEV_IMAGE_URI = imageUri
                    


                    echo "======================================"
                    echo "BUILD ENVIRONMENT = DEV"
                    echo "COMMIT ID         = ${env.COMMIT_ID}"
                    echo "IMAGE TAG         = ${imageTag}"
                    echo "DEV REPOSITORY    = ${env.DEV_REPO}"
                    echo "IMAGE URI         = ${imageUri}"
                    echo "======================================"


                    echo "Building Employee Management Frontend Docker image..."

                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.build(
                            imageUri,
                            env.BUILD_CONTEXT
                        )
                    }


                    echo "Employee Management Frontend Docker image built successfully."
                }
            }
        }


        stage('DEV - Push Image') {

            when {

                expression {

                    params.ENVIRONMENT == 'dev'
                }
            }

            steps {

                script {

                    if (!env.DEV_IMAGE_URI?.trim()) {

                        error(
                            "DEV_IMAGE_URI is empty. " +
                            "DEV image was not built successfully."
                        )
                    }


                    echo "======================================"
                    echo "PUSHING EMPLOYEE MANAGEMENT FRONTEND IMAGE"
                    echo "DEV REPOSITORY = ${env.DEV_REPO}"
                    echo "IMAGE URI       = ${env.DEV_IMAGE_URI}"
                    echo "======================================"


                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.image(
                            env.DEV_IMAGE_URI
                        ).push()
                    }


                    echo "Employee Management Frontend DEV image pushed successfully."
                }
            }
        }


        stage('Promote DEV to QA') {

            when {

                expression {

                    params.ENVIRONMENT in ['qa', 'uat', 'prod']
                }
            }

            steps {

                script {

                    env.DEV_IMAGE_TAG =params.DEV_IMAGE_TAG
                    env.DEV_IMAGE_URI ="${env.ECR_REGISTRY}/${env.DEV_REPO}:${env.DEV_IMAGE_TAG}"


                    promoteImage(
                        env.DEV_REPO,
                        env.QA_REPO,
                        env.DEV_IMAGE_TAG,
                        'QA'
                    )


                    env.QA_IMAGE_TAG ="QA-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                    env.QA_IMAGE_URI ="${env.ECR_REGISTRY}/${env.QA_REPO}:${env.QA_IMAGE_TAG}"


                    echo "============================================================"
                    echo "DEV → QA PROMOTION COMPLETED"
                    echo "DEV IMAGE : ${env.DEV_IMAGE_URI}"
                    echo "QA IMAGE  : ${env.QA_IMAGE_URI}"
                    echo "============================================================"
                }
            }
        }


        stage('Promote QA to UAT') {

            when {

                expression {

                    params.ENVIRONMENT in ['uat', 'prod']
                }
            }

            steps {

                script {

                    promoteImage(
                        env.QA_REPO,
                        env.UAT_REPO,
                        env.QA_IMAGE_TAG,
                        'UAT'
                    )


                    env.UAT_IMAGE_TAG ="UAT-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                    env.UAT_IMAGE_URI ="${env.ECR_REGISTRY}/${env.UAT_REPO}:${env.UAT_IMAGE_TAG}"


                    echo "============================================================"
                    echo "QA → UAT PROMOTION COMPLETED"
                    echo "QA IMAGE  : ${env.QA_IMAGE_URI}"
                    echo "UAT IMAGE : ${env.UAT_IMAGE_URI}"
                    echo "============================================================"
                }
            }
        }


        stage('Promote UAT to PROD') {

            when {

                expression {

                    params.ENVIRONMENT == 'prod'
                }
            }

            steps {

                script {

                    promoteImage(
                        env.UAT_REPO,
                        env.PROD_REPO,
                        env.UAT_IMAGE_TAG,
                        'PROD'
                    )


                    env.PROD_IMAGE_TAG ="PROD-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                    env.PROD_IMAGE_URI ="${env.ECR_REGISTRY}/${env.PROD_REPO}:${env.PROD_IMAGE_TAG}"


                    echo "============================================================"
                    echo "UAT → PROD PROMOTION COMPLETED"
                    echo "UAT IMAGE  : ${env.UAT_IMAGE_URI}"
                    echo "PROD IMAGE : ${env.PROD_IMAGE_URI}"
                    echo "============================================================"
                }
            }
        }


        stage('Deploy Frontend') {

            when {

                expression {

                    params.ENVIRONMENT in ['dev', 'qa', 'uat', 'prod']
                }
            }

            steps {

                script {

                    if (params.ENVIRONMENT == 'dev') {

                        deployFrontend(
                            'dev',
                            env.DEV_REPO,
                            env.DEV_IMAGE_TAG
                        )
                    }


                    if (params.ENVIRONMENT == 'qa') {

                        deployFrontend(
                            'qa',
                            env.QA_REPO,
                            env.QA_IMAGE_TAG
                        )
                    }


                    if (params.ENVIRONMENT == 'uat') {

                        deployFrontend(
                            'uat',
                            env.UAT_REPO,
                            env.UAT_IMAGE_TAG
                        )
                    }
                }
            }
        }


        stage('Production Approval') {

            when {

                expression {

                    params.ENVIRONMENT == 'prod'
                }
            }

            steps {

                input(

                    message:
                        "DEV → QA → UAT Frontend promotion completed. " +
                        "Deploy Employee Management Frontend to PROD?",

                    ok:
                        'Deploy to PROD'
                )
            }
        }


        stage('Deploy Frontend - PROD') {

            when {

                expression {

                    params.ENVIRONMENT == 'prod'
                }
            }

            steps {

                script {

                    deployFrontend(
                        'prod',
                        env.PROD_REPO,
                        env.PROD_IMAGE_TAG
                    )
                }
            }
        }
    }


    post {

        always {

            echo 'Cleaning Jenkins workspace...'

            cleanWs()
        }


        success {

            echo '''
============================================================
EMPLOYEE MANAGEMENT FRONTEND ECS CI/CD COMPLETED SUCCESSFULLY.

DEV  -> QA -> UAT -> PROD
============================================================
'''
        }


        failure {

            echo '''
============================================================
EMPLOYEE MANAGEMENT FRONTEND ECS CI/CD FAILED.

Check the Jenkins console output.
============================================================
'''
        }
    }
}


def promoteImage(
    String sourceRepo,
    String targetRepo,
    String sourceTag,
    String targetEnvironment
) {

    def sourceImage ="${env.ECR_REGISTRY}/${sourceRepo}:${sourceTag}"
    def targetTag ="${targetEnvironment}-${sourceTag.replaceFirst('^DEV-', '')}"
       


    def targetImage ="${env.ECR_REGISTRY}/${targetRepo}:${targetTag}"
        
    echo "============================================================"
    echo "PROMOTING EMPLOYEE MANAGEMENT FRONTEND IMAGE"
    echo "============================================================"
    echo "SOURCE REPOSITORY : ${sourceRepo}"
    echo "SOURCE IMAGE      : ${sourceImage}"
    echo "TARGET REPOSITORY : ${targetRepo}"
    echo "TARGET IMAGE      : ${targetImage}"
    echo "============================================================"


    withCredentials([

        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]

    ]) {

        sh """

            set -e


            echo "AWS Identity:"


            aws sts get-caller-identity


            echo "Logging in to ECR..."


            aws ecr get-login-password \
                --region ${env.AWS_REGION} \
                | docker login \
                    --username AWS \
                    --password-stdin ${env.ECR_REGISTRY}


            echo "Pulling source image..."


            docker pull ${sourceImage}


            echo "Tagging image..."


            docker tag \
                ${sourceImage} \
                ${targetImage}


            echo "Pushing promoted image..."


            docker push ${targetImage}


            echo "============================================================"
            echo "PROMOTION COMPLETED"
            echo "SOURCE IMAGE: ${sourceImage}"
            echo "TARGET IMAGE: ${targetImage}"
            echo "============================================================"

        """
    }
}


def deployFrontend(
    String environment,
    String repository,
    String imageTag
) {

    def imageUri ="${env.ECR_REGISTRY}/${repository}:${imageTag}"
        
    def taskDefinitionFile ="new-frontend-task-definition-${environment}.json
      


    echo "============================================================"
    echo "DEPLOYING EMPLOYEE MANAGEMENT FRONTEND"
    echo "============================================================"
    echo "Environment : ${environment}"
    echo "Repository  : ${repository}"
    echo "Image Tag   : ${imageTag}"
    echo "Image URI   : ${imageUri}"
    echo "============================================================"


    withCredentials([

        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]

    ]) {

        withEnv([

            "DEPLOY_ENV=${environment}",
            "IMAGE_URI=${imageUri}",
            "TASK_TEMPLATE=${env.TASK_DEFINITION_TEMPLATE}",
            "OUTPUT_FILE=${taskDefinitionFile}",
            "AWS_REGION_VALUE=${env.AWS_REGION}"

        ]) {

            sh '''

                set -e


                echo "AWS Identity:"


                aws sts get-caller-identity


                echo "Creating ECS task definition for ${DEPLOY_ENV}..."


                python3 - <<'PYTHON'

import json
import os


input_file = os.environ["TASK_TEMPLATE"]

output_file = os.environ["OUTPUT_FILE"]

environment = os.environ["DEPLOY_ENV"]

image_uri = os.environ["IMAGE_URI"]


with open(input_file, "r") as f:

    task_definition = json.load(f)


task_definition["family"] = \
    f"employee-mgm-{environment}-frontend"


container_found = False


for container in task_definition["containerDefinitions"]:

    if container["name"] == "frontend":

        container["image"] = image_uri

        container_found = True

        break


if not container_found:

    raise Exception(
        "Container named 'frontend' was not found."
    )


remove_fields = [

    "taskDefinitionArn",
    "revision",
    "status",
    "requiresAttributes",
    "compatibilities",
    "registeredAt",
    "registeredBy"

]


for field in remove_fields:

    task_definition.pop(
        field,
        None
    )


with open(output_file, "w") as f:

    json.dump(
        task_definition,
        f,
        indent=2
    )


print("Task definition created:")

print(output_file)


print("Frontend image:")

print(image_uri)

PYTHON


                echo "Generated task definition:"


                cat "${OUTPUT_FILE}"


                echo "Registering ECS task definition..."


                REVISION=$(aws ecs register-task-definition \
                    --cli-input-json "file://${OUTPUT_FILE}" \
                    --region "${AWS_REGION_VALUE}" \
                    --query 'taskDefinition.revision' \
                    --output text)


                echo "AWS REGISTERED REVISION = ${REVISION}"


                if [ -z "${REVISION}" ] || \
                   [ "${REVISION}" = "null" ] || \
                   [ "${REVISION}" = "None" ]; then

                    echo "ERROR: ECS returned invalid revision."

                    exit 1

                fi


                echo "Updating ECS Frontend service..."


                aws ecs update-service \
                    --cluster "employee-mgm-${DEPLOY_ENV}-cluster" \
                    --service "employee-mgm-${DEPLOY_ENV}-frontend-service" \
                    --task-definition "employee-mgm-${DEPLOY_ENV}-frontend:${REVISION}" \
                    --force-new-deployment \
                    --region "${AWS_REGION_VALUE}"


                echo "Waiting for ECS Frontend service to become stable..."


                aws ecs wait services-stable \
                    --cluster "employee-mgm-${DEPLOY_ENV}-cluster" \
                    --services "employee-mgm-${DEPLOY_ENV}-frontend-service" \
                    --region "${AWS_REGION_VALUE}"


                echo "============================================================"
                echo "EMPLOYEE MANAGEMENT FRONTEND ${DEPLOY_ENV} DEPLOYMENT COMPLETED."
                echo "IMAGE: ${IMAGE_URI}"
                echo "============================================================"

            '''
        }
    }
}

